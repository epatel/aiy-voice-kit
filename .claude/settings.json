{
  "permissions": {
    "deny": [
      "Edit(/docs/aiyprojects-raspbian/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/regen-patches.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
