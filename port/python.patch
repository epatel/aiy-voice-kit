+def _fix_wav_sizes(filename):
+    """Sets the RIFF and data chunk sizes in a WAV header from the file's real size.
+
+    arecord 1.2.14 (Trixie) exits on SIGTERM without finishing the header, leaving the
+    placeholder sizes (about 2 GB) that make readers fail or allocate huge buffers.
+    """
+    with open(filename, 'r+b') as f:
+        size = os.fstat(f.fileno()).st_size
+        header = f.read(12)
+        if size < 12 or header[:4] != b'RIFF' or header[8:12] != b'WAVE':
+            return
+        f.seek(4)
+        f.write(struct.pack('<I', size - 8))
+        pos = 12
+        while pos + 8 <= size:
+            f.seek(pos)
+            chunk_id, chunk_size = struct.unpack('<4sI', f.read(8))
+            if chunk_id == b'data':
+                f.seek(pos + 4)
+                f.write(struct.pack('<I', size - pos - 8))
+                return
+            pos += 8 + chunk_size + (chunk_size & 1)
 
 
